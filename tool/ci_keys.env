# Placeholders that replace the real Google API keys in the PUBLIC CI mirror.
# Sourced by tool/make_ci_snapshot.sh (redacts) and tool/restore_ci_keys.sh
# (CI puts the real keys back from repository secrets before building).
#
# Shape matters: the Firebase SDKs refuse to start (Android throws, iOS raises
# an NSException) unless the key is "A" + 38 of [A-Za-z0-9_-]. These match that
# shape but do not start with "AIza", so GitHub secret scanning ignores them.
CI_PH_FB_ANDROID=AREDACTED-FIREBASE-ANDROID-KEY-00000000
CI_PH_FB_APPLE=AREDACTED-FIREBASE-APPLE-KEY-0000000000
CI_PH_PLACES_ANDROID=AREDACTED-PLACES-ANDROID-KEY-0000000000
CI_PH_PLACES_IOS=AREDACTED-PLACES-IOS-KEY-00000000000000
