# Copy this file to secrets.properties (same folder) and fill in real
# values. secrets.properties is gitignored -- never commit it.
#
# This file is the single source of truth for every key/credential this
# app needs. Two build systems read it automatically:
#   - Android/Gradle reads it directly (see android/app/build.gradle.kts)
#   - Flutter reads it via --dart-define-from-file=secrets.properties
#     (see the run/build commands at the bottom of this file)
#
# iOS is the one exception -- Xcode's Info.plist can't read this file
# automatically without extra Xcode project wiring that isn't safe to
# generate without Xcode itself. For iOS keys, copy the value from here
# into ios/Runner/Info.plist by hand; each relevant key there has a
# comment pointing back to which line in this file it should match.
#
# Format: plain KEY=value, one per line, no quotes needed.

# --- Google Maps SDK ---------------------------------------------------
# Get from: https://console.cloud.google.com/google/maps-apis/credentials
# Needs "Maps SDK for Android" / "Maps SDK for iOS" enabled respectively.
# ALSO needs "Places API (New)" enabled on this same key/project -- these
# same two keys are reused by lib/services/places_service.dart for
# location search (Places Autocomplete), not just the map SDK. See
# PLACES_COST_NOTES.md for why that's a deliberate choice and what to
# watch for on the billing side.
MAPS_API_KEY_ANDROID=YOUR_GOOGLE_MAPS_ANDROID_API_KEY
MAPS_API_KEY_IOS=YOUR_GOOGLE_MAPS_IOS_API_KEY

# If MAPS_API_KEY_ANDROID has Cloud Console's "Android apps" restriction
# enabled (recommended -- an unrestricted key is a liability): the native
# Maps SDK identifies itself to Google automatically via the OS, but the
# raw HTTP calls in places_service.dart do not, and need these two
# headers set explicitly or every request gets rejected with "Requests
# from this Android client application <empty> are blocked" no matter
# how correctly the key/restriction itself is configured. Package name
# is hardcoded in places_service.dart (it's stable across builds); this
# is the signing certificate's SHA-1 fingerprint (colons stripped), which
# is NOT stable -- debug and release use different keystores. Get the
# debug one via: keytool -list -v -keystore
# %USERPROFILE%\.android\debug.keystore -alias androiddebugkey -storepass
# android -keypass android
# A release build needs its own release-keystore fingerprint here, added
# as an ADDITIONAL package+SHA-1 entry in Console (not a replacement).
ANDROID_CERT_SHA1=YOUR_DEBUG_OR_RELEASE_CERT_SHA1_NO_COLONS

# --- Google Sign-In (iOS only -- Android uses google-services.json) -----
# From ios/Runner/GoogleService-Info.plist after registering an iOS app
# in the Firebase console: the REVERSED_CLIENT_ID value.
GOOGLE_REVERSED_CLIENT_ID_IOS=YOUR_REVERSED_CLIENT_ID

# --- Facebook Login ------------------------------------------------------
# Get from: https://developers.facebook.com/apps -> Your App -> Settings -> Basic
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_CLIENT_TOKEN=YOUR_FACEBOOK_CLIENT_TOKEN

# --- AdMob -----------------------------------------------------------
# Get from: https://admob.google.com -> Apps -> App settings / Ad units.
# Leave the *_APP_ID values as the test IDs below until you're ready for
# real ads -- they're Google's official public test App IDs and always
# work. Swap AdService.useTestAds to false (lib/services/ad_service.dart)
# only once these are all real production values.
ADMOB_APP_ID_ANDROID=ca-app-pub-3940256099942544~3347511713
ADMOB_APP_ID_IOS=ca-app-pub-3940256099942544~1458002511
ADMOB_BANNER_AD_UNIT_ID_ANDROID=ca-app-pub-3940256099942544/6300978111
ADMOB_BANNER_AD_UNIT_ID_IOS=ca-app-pub-3940256099942544/2934735716

# --- Backend ---------------------------------------------------------
# Where the Flutter app should reach your deployed FastAPI backend.
API_BASE_URL=http://10.55.3.98:8000/api

# ---------------------------------------------------------------------
# HOW TO RUN/BUILD WITH THIS FILE:
#
#   flutter run --dart-define-from-file=secrets.properties
#   flutter build apk --dart-define-from-file=secrets.properties
#   flutter build ios --dart-define-from-file=secrets.properties
#
# (Requires Flutter 3.13+. If your version is older and this flag isn't
# recognized, pass each value individually instead:
#   flutter run --dart-define=API_BASE_URL=... --dart-define=ADMOB_BANNER_AD_UNIT_ID_ANDROID=... )
#
# Android picks this file up automatically on every build (no extra
# flag needed) -- see android/app/build.gradle.kts.
