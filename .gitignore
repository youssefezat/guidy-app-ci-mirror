# API keys / secrets -- see secrets.properties.example for the template.
# secrets.properties IS committed to the private guidy-app repo (force-added,
# so the whole team and test Macs build with real keys). It must never reach
# the PUBLIC guidy-app-ci-mirror: tool/make_ci_snapshot.sh strips it from
# every mirror snapshot, push_ci_mirror.bat refuses a snapshot containing it,
# and CI fails if it ever shows up in a public repo. The ignore line stays so
# local copies in other checkouts aren't picked up by accident.
secrets.properties
# Generated from secrets.properties by run_ios.sh / CI.
/build/dart_defines.json

# Firebase CLI deploy cache -- records which files were last uploaded so
# `firebase deploy` can skip unchanged ones. Local, machine-specific, and
# regenerated on every deploy.
.firebase/
