<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Debug builds only. Android 9 (API 28) and up block cleartext HTTP by
         default, so a debug build talking to the Guidy backend over
         http://10.0.2.2:8000 (the emulator's route to the host machine) or
         over a LAN IP fails with:

           CLEARTEXT communication to 10.0.2.2 not permitted by
           network security policy

         This file lives in src/debug, so it applies to debug builds and
         nothing else. Release builds keep Android's default of HTTPS only,
         which is what we want once the backend is deployed behind TLS. Do
         not move this into src/main to "fix" a release build; fix the URL.

         (Note for anyone editing this comment: XML forbids a double hyphen
         inside a comment, and one here is what broke the manifest merger
         the first time round.)
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
